// Asymmetric Reactor coverage — the element whose SpecType-4 stamp bug
// (03c63f2: series bottom-left block written at (j+n,i) instead of Pascal's
// (i+n,j), Reactor.pas:936) motivated this deck family. All four SpecTypes,
// series + shunt, wye + delta, 1/2/3-phase, plus a FULL asymmetric
// Rmatrix/Xmatrix input that pins the parser's ParseAsSymMatrix
// lower-triangle-wins symmetrization order.
clear
Set DefaultBaseFrequency=60

New circuit.rx_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

! (1) SpecType=4: Z1 <> Z2 -> non-reciprocal YPrim (the 03c63f2 regression).
New reactor.rz12 phases=3 bus1=src bus2=b1
~ Z1=[1.9775 1.3431] Z2=[0.1203 0.3623] Z0=[1 0]

! (2) SpecType=3: FULL asymmetric matrix input (engine symmetrizes,
!     lower-triangle-wins — both engines must agree on the result).
New reactor.rmat phases=3 bus1=b1 bus2=b2
~ rmatrix=[0.9 0.15 0.05 | 0.35 1.1 0.1 | 0.22 0.4 1.0]
~ xmatrix=[2.4 0.5 0.2 | 0.9 2.7 0.45 | 0.6 1.2 2.5]

! (3) SpecType=2 (R+X) two-phase series reactor on phases 1 & 3 only;
!     phase 2 continues through a plain jumper.
New reactor.rrx phases=2 bus1=b2.1.3 bus2=b3.1.3 R=0.25 X=0.9
New line.j2 phases=1 bus1=b2.2 bus2=b3.2 r1=0.05 x1=0.15 r0=0.05 x0=0.15 c1=0 c0=0 length=1

! (4) SpecType=1 (kvar) single-phase shunt reactor on phase 2.
New reactor.rsh phases=1 bus1=b3.2 kvar=150 kv=7.2

! (5) Delta-connected 3-phase kvar shunt reactor.
New reactor.rdel phases=3 bus1=b3 conn=delta kvar=450 kv=12.47

! (6) R+X series reactor with a parallel resistor branch (Rp).
New reactor.rp phases=3 bus1=b3 bus2=b4 R=0.15 X=1.2 Rp=800

! Unbalanced excitation.
New load.la bus1=b4.1 phases=1 conn=wye model=1 kv=7.2 kw=800 pf=0.9
New load.lb bus1=b4.2 phases=1 conn=wye model=1 kv=7.2 kw=200 pf=0.95
New load.lc bus1=b4.3 phases=1 conn=wye model=1 kv=7.2 kw=1400 pf=0.85

Set voltagebases=[12.47]
calcv
