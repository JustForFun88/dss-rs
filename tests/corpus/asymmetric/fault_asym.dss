// Asymmetric Fault coverage: single-line-to-ground, line-to-line, and a
// 3-phase fault specified by a FULL asymmetric Gmatrix input (pins the
// ParseAsSymMatrix lower-triangle-wins order). Fault resistances are kept
// moderate so the unbalanced snapshot converges cleanly.
clear
Set DefaultBaseFrequency=60

New circuit.flt_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

New line.t1 bus1=src bus2=b1 r1=0.08 x1=0.25 r0=0.25 x0=0.8 c1=0 c0=0 length=1
New line.t2 bus1=b1 bus2=b2 r1=0.09 x1=0.3 r0=0.3 x0=0.95 c1=0 c0=0 length=1

! Single-line-to-ground fault on phase 1.
New fault.fslg phases=1 bus1=b1.1 r=0.5

! Line-to-line fault between phases 2 and 3.
New fault.fll phases=1 bus1=b1.2 bus2=b1.3 r=1.2

! 3-phase fault as a FULL asymmetric Gmatrix (S).
New fault.fmat phases=3 bus1=b2
~ gmatrix=[0.8 0.1 0.05 | 0.25 0.9 0.15 | 0.12 0.3 0.7]

! Background unbalanced load.
New load.la bus1=b2.1 phases=1 conn=wye model=1 kv=7.2 kw=500 pf=0.9
New load.lc bus1=b2.3 phases=1 conn=wye model=1 kv=7.2 kw=800 pf=0.85

Set voltagebases=[12.47]
calcv
