! GAPS deck: AutoTrans at GIC frequency — the Solution.Frequency < 0.51 Hz
! branch (Pascal AutoTrans.pas GICBuildYTerminal:1823): resistance-only Y_Term
! from 1/RdcOhms per winding, no inter-winding coupling, ppm float adder as
! conductance. RdcOhms left at its default 0.85*Rpu derivation for t1 and set
! explicitly for t2. Single snapshot at Set frequency=0.1.
Clear
Set DefaultBaseFrequency=60
! Fed from a physical 345 kV source directly on the series winding (see
! autotrans_snap.dss); the near-ideal source through an r1=1e-6 switch is
! avoided so the GIC compare pins only the AutoTrans GICBuildYTerminal path.
New Circuit.gaps_autogic basekv=345.0 phases=3 mvasc3=30000 25000
New AutoTrans.t1 phases=3 windings=3 xhx=7.23 xht=24.45 xxt=28.45 %imag=0.0329
~ wdg=1 bus=sourcebus conn=s kV=345.0 kVA=330000 %r=0.0493
~ wdg=2 bus=low  conn=w kV=161.0 kVA=330000 %r=0.0556
~ wdg=3 bus=tert conn=d kV=13.8  kVA=72000  %r=1.4503
New AutoTrans.t2 phases=3 windings=2 xhx=8.5
~ wdg=1 bus=low  conn=s kV=161 kVA=50000 %r=0.08 rdcohms=0.9
~ wdg=2 bus=mid2 conn=w kV=69  kVA=50000 %r=0.09 rdcohms=0.5
! Grounding-path reactors (pure R) so a DC loop exists at 0.1 Hz.
New Reactor.g_high phases=3 bus1=sourcebus r=0.15 x=0
New Reactor.g_mid2 phases=3 bus1=mid2 r=0.25 x=0
Set voltagebases=[345.0 161.0 69.0 13.8]
Calcvoltagebases
Set frequency=0.1
Solve
