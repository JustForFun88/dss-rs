// Asymmetric DER coverage — the inverter state-machine branches der_asym leaves
// in their normal operating region, all WYE-3phase (der_asym only has a delta
// 3ph PV):
//   stidle   Storage FState = IDLING (Storage.pas:35/1410): near-zero real
//            injection but Yeq (idling loss) still stamps — the distinct idling
//            branch, not charging/discharging.
//   pvcut    PVSystem forced below %CutOut (irradiance < cutin threshold ->
//            panel power under the cutout -> inverter P=0 branch).
//   pvclamp  PVSystem at the reactive limit: a large commanded kvar with a tight
//            kvarMax + WattPriority=yes latches the kvar clamp.
// Unbalanced loads keep every stamp asymmetric. n_steps=1, YPrim + node-V.
clear
Set DefaultBaseFrequency=60

New circuit.der_state_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

New line.t1 bus1=src bus2=b1 r1=0.08 x1=0.25 r0=0.25 x0=0.8 c1=0 c0=0 length=1

! Storage IDLING, wye 3-phase.
New storage.stidle phases=3 bus1=b1 conn=wye kv=12.47 kwrated=500 kwhrated=1000
~ state=idling

! PVSystem below CutOut, wye 3-phase: irradiance under the cutin/cutout -> P=0.
New pvsystem.pvcut phases=3 bus1=b1 conn=wye kv=12.47 kva=500 Pmpp=400
~ irradiance=0.05 %cutin=20 %cutout=20 pf=1

! PVSystem at the kvar limit, wye 3-phase: big commanded kvar, tight kvarMax +
! WattPriority latches the reactive clamp.
New pvsystem.pvclamp phases=3 bus1=b1 conn=wye kv=12.47 kva=500 Pmpp=450
~ irradiance=0.9 kvar=400 kvarMax=50 WattPriority=yes VarFollowInverter=no

! Unbalanced excitation.
New load.la bus1=b1.1 phases=1 conn=wye model=1 kv=7.2 kw=850 pf=0.9
New load.lb bus1=b1.2 phases=1 conn=wye model=1 kv=7.2 kw=220 pf=0.95
New load.lc bus1=b1.3 phases=1 conn=wye model=1 kv=7.2 kw=1200 pf=0.85

Set voltagebases=[12.47]
calcv
