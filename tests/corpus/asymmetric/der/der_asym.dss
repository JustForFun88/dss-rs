// Asymmetric DER coverage: PVSystem (3-phase delta + 1-phase) and Storage
// (3-phase discharging + 1-phase charging) in an unbalanced network.
clear
Set DefaultBaseFrequency=60

New circuit.der_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

New line.t1 bus1=src bus2=b1 r1=0.08 x1=0.25 r0=0.25 x0=0.8 c1=0 c0=0 length=1

! 3-phase delta PVSystem at partial irradiance.
New pvsystem.pv3 phases=3 bus1=b1 conn=delta kv=12.47 kva=600 pmpp=500
~ irradiance=0.9 pf=0.98

! 1-phase PVSystem on phase 2.
New pvsystem.pv1 phases=1 bus1=b1.2 kv=7.2 kva=150 pmpp=120 irradiance=0.85 pf=1

! 3-phase Storage discharging.
New storage.st3 phases=3 bus1=b1 kv=12.47 kwrated=500 kwhrated=1000
~ state=discharging %discharge=80

! 1-phase Storage charging on phase 3.
New storage.st1 phases=1 bus1=b1.3 kv=7.2 kwrated=120 kwhrated=240
~ state=charging %charge=60

! Unbalanced load.
New load.la bus1=b1.1 phases=1 conn=wye model=1 kv=7.2 kw=900 pf=0.9
New load.lb bus1=b1.2 phases=1 conn=wye model=1 kv=7.2 kw=250 pf=0.95
New load.lc bus1=b1.3 phases=1 conn=wye model=1 kv=7.2 kw=1300 pf=0.85

Set voltagebases=[12.47]
calcv
