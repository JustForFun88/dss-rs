// Asymmetric Line coverage — CABLE path (Line.pas geometry with CNData /
// TSData). One concentric-neutral (CN) segment and one tape-shield (TS)
// segment: the Kron neutral-elimination differs CN vs TS (CN eliminates the
// stranded concentric neutrals; TS eliminates the tape shield + a separate CU
// neutral wire), both under `reduce=y`. Asymmetric underground burial spacing
// (distinct x/h per cable) keeps the reduced Y full-asym; unbalanced load.
// Conductor data transcribed from Test/CableParameters.dss.
clear
Set DefaultBaseFrequency=60

New circuit.line_cable_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100
Set EarthModel=Carson

new WireData.CU_1-0 NormAmps=100 DIAM=0.368 GMRac=0.13356 Rac=0.607 Runits=mi Radunits=in gmrunits=in

new CNData.CN_250 NormAmps=260 DIAM=0.567 GMRac=0.20520 Rac=0.41 Runits=mi Radunits=in gmrunits=in
~ EpsR=2.3 Ins=0.220 DiaIns=1.06 DiaCable=1.29 k=13 DiaStrand=0.0641 GmrStrand=0.02496 Rstrand=14.8722

new TSData.TS_1-0 NormAmps=165 DIAM=0.368 GMRac=0.13320 Rac=0.97 Runits=mi Radunits=in gmrunits=in
~ EpsR=2.3 Ins=0.220 DiaIns=0.82 DiaCable=1.06 DiaShield=0.88 TapeLayer=0.005 TapeLap=20

! CN 3-phase underground, asymmetric burial (distinct x AND h per phase).
new LineGeometry.cn3 nconds=3 nphases=3 reduce=y
~ cond=1 cncable=CN_250 x=-0.5 h=-4.0 units=ft
~ cond=2 cncable=CN_250 x= 0.1 h=-4.3 units=ft
~ cond=3 cncable=CN_250 x= 0.6 h=-3.7 units=ft

! TS 1-phase underground with a separate CU neutral return.
new LineGeometry.ts1 nconds=2 nphases=1 reduce=y
~ cond=1 tscable=TS_1-0 x=0.0  h=-4.0 units=ft
~ cond=2 wire=CU_1-0    x=0.25 h=-4.0 units=ft

new line.lcn bus1=src bus2=b1 geometry=cn3 length=2 units=kft
new line.lts phases=1 bus1=b1.1 bus2=b2.1 geometry=ts1 length=1.5 units=kft

! Unbalanced excitation.
New load.la bus1=b2.1 phases=1 conn=wye model=1 kv=7.2 kw=280 pf=0.9
New load.lb bus1=b1.2 phases=1 conn=wye model=1 kv=7.2 kw=600 pf=0.95
New load.lc bus1=b1.3 phases=1 conn=wye model=1 kv=7.2 kw=950 pf=0.85

Set voltagebases=[12.47]
calcv
