! GAPS deck: the GIC family at midi scale — a 6-substation transmission ring
! chaining all three classes (GIC_Example is GICLine+GICTransformer only;
! GICsource has ZERO vendored coverage). Spans mix Volts / EN-EE geodesy /
! blocking-C GICLines with two ordinary Lines carrying spliced GICsources;
! GSU / YY / Auto GICTransformers ground through per-substation grids.
! Quasi-DC snapshot at Set frequency=0.1. (No async variant exists for the
! GIC classes upstream: none has a shape reference or time-varying drive.)
Clear
Set DefaultBaseFrequency=60
New Circuit.gaps_gicm basekv=345 phases=3 bus1=b1 mvasc3=2000000 2000000
! Ring spans b1..b6: GICLines (three spec styles) + two GICsource-spliced Lines.
New GICLine.gl12 bus1=b1 bus2=b2 R=3.5 Volts=120 Angle=0
New GICLine.gl23 bus1=b2 bus2=b3 R=2.8 EN=1.0 EE=1.0
~ Lat1=33.613499 Lon1=-87.373673 Lat2=33.547885 Lon2=-86.074605
New GICLine.gl34 bus1=b3 bus2=b4 R=3.1 C=32.0 Volts=80 Angle=0
New Line.seg45 bus1=b4 bus2=b5 phases=3 r1=3.2 x1=0.1 r0=3.2 x0=0.1 c1=0 c0=0 length=1
New Line.seg56 bus1=b5 bus2=b6 phases=3 r1=2.7 x1=0.1 r0=2.7 x0=0.1 c1=0 c0=0 length=1
New GICLine.gl61 bus1=b6 bus2=b1 R=3.3 EN=0.6 EE=1.2
~ Lat1=33.500000 Lon1=-87.100000 Lat2=33.613499 Lon2=-87.373673
New GICsource.seg45 Volts=110 Angle=0 Frequency=0.1
New GICsource.seg56 EN=1.0 EE=1.0 Frequency=0.1
~ Lat1=33.480000 Lon1=-86.800000 Lat2=33.420000 Lon2=-86.300000
! Transformers: GSU at b1, YY at b3, Auto at b5 (%R spec + VarCurve at b5).
New GICTransformer.tg1 busH=b1 busNH=b1.4.4.4 R1=0.12 type=GSU
New GICTransformer.tg3 busH=b3 busNH=b3.4.4.4 busX=b3x busNX=b3.4.4.4 R1=0.2 R2=0.1 type=YY
New XYcurve.vgic npts=3 xarray=(0 1 2) yarray=(0 0.6 1.0)
New GICTransformer.tg5 busH=b5 busX=b5x busNX=b5.4.4.4 %R1=0.2 %R2=0.15
~ kvll1=345 kvll2=138 mva=300 varcurve=vgic type=Auto
! Ground grids: transformer neutrals (node 4) + direct bus grounds.
New Reactor.gg1 phases=1 bus1=b1.4 r=0.20 x=0
New Reactor.gg3 phases=1 bus1=b3.4 r=0.15 x=0
New Reactor.gg5 phases=1 bus1=b5.4 r=0.25 x=0
New Reactor.g2 phases=3 bus1=b2 r=0.18 x=0
New Reactor.g4 phases=3 bus1=b4 r=0.22 x=0
New Reactor.g6 phases=3 bus1=b6 r=0.16 x=0
Set voltagebases=[345 138]
Calcvoltagebases
Set frequency=0.1
Solve
