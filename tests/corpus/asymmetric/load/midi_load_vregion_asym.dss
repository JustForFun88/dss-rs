// Asymmetric Load coverage — the VOLTAGE-REGION state machine (Load.pas:
// 1373/1433/1473/1658). Every voltage-dependent load model clamps/interpolates
// across four regions; the flat load_asym deck only ever exercises the NORMAL
// region. Here a weak source + high-impedance radial feeder develops real,
// physical, unbalanced voltage sag so the far loads fall below Vminpu (into the
// InterpolateY95_YLow region) and, at the tail, below Vlowpu (const-Z Yeq),
// while a capacitor-boosted stub off the source pushes a load above Vmaxpu (the
// Yeq105 clamp). Models 1/3/5 each have their OWN interpolation path
// (interpolate_y95_ylow vs interpolate_y95i_ylow vs the motor form), and models
// 6/7 (constP-fixedQ / constP-constZ<Vmin) use their fixed-susceptance yq_fixed
// off the pure-PQ curve — all of which coincide with model 1 in the normal
// region and only diverge once a region boundary is crossed. n_steps=1, "*".
clear
Set DefaultBaseFrequency=60

New circuit.load_vregion_asym basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src
~ mvasc3=800 mvasc1=700

! --- Capacitor-boosted stub off the strong source: bs rises above Vmaxpu. ---
New line.ls bus1=src bus2=bs r1=0.1 x1=0.8 r0=0.3 x0=2.2 c1=0 c0=0 length=1
New capacitor.cb bus1=bs phases=3 conn=wye kvar=5200 kv=12.47
! Model 6 above Vmaxpu -> Yeq105 clamp with fixed Q (yq_fixed), distinct from PQ.
New load.hi6 bus1=bs.1 phases=1 conn=wye model=6 kv=7.2 kw=40 pf=0.95 vmaxpu=1.02
New load.hi1 bus1=bs.2 phases=1 conn=wye model=1 kv=7.2 kw=35 pf=0.95 vmaxpu=1.02

! --- Sagging radial feeder: src -> b1 -> b2 -> b3 (far, heavy, unbalanced). ---
New line.l1 bus1=src bus2=b1 r1=0.35 x1=0.9 r0=0.9 x0=2.6 c1=0 c0=0 length=3
New line.l2 bus1=b1 bus2=b2 r1=0.4 x1=1.0 r0=1.0 x0=2.9 c1=0 c0=0 length=3
New line.l3 bus1=b2 bus2=b3 r1=0.5 x1=1.2 r0=1.2 x0=3.4 c1=0 c0=0 length=3

! Far-bus heavy loads: sag to ~0.80-0.90 pu -> below Vminpu (interpolation).
! Model 6 (constP fixedQ) and Model 7 (constP constZ<Vmin) in the interp region.
New load.f6 bus1=b3.1 phases=1 conn=wye model=6 kv=7.2 kw=900  pf=0.90 vminpu=0.94 vlowpu=0.60
New load.f7 bus1=b3.2 phases=1 conn=wye model=7 kv=7.2 kw=1200 pf=0.85 vminpu=0.94 vlowpu=0.60
New load.f3 bus1=b3.3 phases=1 conn=wye model=3 kv=7.2 kw=700  pf=0.88 vminpu=0.94

! Mid-bus loads: models 3 (motor) and 5 (const |I|) in the interpolation region.
New load.m5 bus1=b2.2 phases=1 conn=wye model=5 kv=7.2 kw=350 pf=0.9 vminpu=0.94
New load.m1 bus1=b2.1 phases=1 conn=wye model=1 kv=7.2 kw=250 pf=0.9 vminpu=0.94

! Const-Z fallback (below Vlowpu): a model-1 load whose Vlowpu sits above the
! b3.2 sag (~0.80 pu) -> the V<Vlow branch fires (all models collapse to Yeq).
New load.flow bus1=b3.2 phases=1 conn=wye model=1 kv=7.2 kw=150 pf=0.9 vminpu=0.94 vlowpu=0.85

Set voltagebases=[12.47]
calcv
