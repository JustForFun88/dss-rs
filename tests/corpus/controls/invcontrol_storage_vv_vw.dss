! GAPS deck (WPG.10): InvControl CombiMode=VV_VW over a discharging Storage.
! BOTH the volt-var (Q) and volt-watt (P) laws GENUINELY BITE: a weak source
! (mvasc3=20) + a resistive line (r1=2.0) let the 2 MW discharge lift the
! storage-bus voltage, so the combi controller both ABSORBS vars (vv curve) and
! THROTTLES the discharge (vw curve) to a settled joint equilibrium.
!
! `vv`: y ramps +1 -> -1 over V/Vrated 0.95->1.05 (absorb vars when high);
! `vw`: y ramps 1 -> 0.2 over V/Vrated 1.0->1.05 (limit discharge when high);
! voltage_curvex_ref=rated. Feature-sensitivity (pinned oracle dss-python
! 0.15.7, 6x 1h daily steps; %stored ~75->50, no depletion):
!   WITH   InvControl.ic:  P ~1306 kW, Q ~+657 kvar absorbed, V(b1) ~1.0217 pu
!   WITHOUT InvControl.ic: P = full 2000 kW, Q ~0,            V(b1) ~1.0875 pu
! kW 1306 vs 2000, kvar 657 vs 0, %stored 50.5 vs 35.1 at step 6 diverge far
! above the micro tolerance -> a live gate for the ported Storage VV_VW combi.
! (Two-process oracle capture is bit-identical; determinism proven.)
Clear
New Circuit.gaps_icvvvw basekv=12.47 phases=3 bus1=sourcebus mvasc3=20 mvasc1=21
New XYcurve.vv npts=4 xarray=(0.5 0.95 1.05 1.5) yarray=(1.0 1.0 -1.0 -1.0)
New XYcurve.vw npts=4 xarray=(0.5 1.0 1.05 1.5) yarray=(1.0 1.0 0.2 0.2)
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=2.0 x1=0.5 c1=0 length=3 units=km
New Storage.batt bus1=b1 phases=3 kv=12.47 kva=2000 kwrated=2000 kwhrated=30000 %stored=80 state=discharging %discharge=100 dispmode=default
New InvControl.ic derlist=[storage.batt] combimode=VV_VW vvc_curve1=vv voltwatt_curve=vw voltage_curvex_ref=rated deltaq_factor=0.4 deltap_factor=0.4 eventlog=yes
New Monitor.m_b element=Storage.batt terminal=1 mode=1 ppolar=no
Set voltagebases=[12.47]
Calcvoltagebases
Set maxcontroliter=200
Set mode=daily stepsize=1h number=1
