// CapControl asymmetric scenario: a kvar-mode CapControl (monitoring one
// terminal of an unbalanced feeder) switching a two-step wye bank, plus a
// current-mode CapControl with a phase-3 CT on a second bank — per-phase
// unequal daily loads drive both through their ON/OFF settings. Compared per
// step: full model + both banks' step states, setting probes, event log.
clear
Set DefaultBaseFrequency=60

New circuit.capasym basekv=12.47 pu=1.03 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

New line.lf bus1=src bus2=b r1=0.3 x1=0.7 r0=0.7 x0=1.9 c1=0 c0=0 length=3
New line.lt bus1=b bus2=c r1=0.25 x1=0.6 r0=0.6 x0=1.6 c1=0 c0=0 length=2

! kvar-mode control on the feeder head, switching the 2-step bank at b.
New capacitor.cb1 phases=3 bus1=b conn=wye kvar=900 kv=12.47 numsteps=2
New capcontrol.ck element=line.lf terminal=1 capacitor=cb1 type=kvar
~ onsetting=800 offsetting=200 eventlog=yes

! current-mode control with a phase-3 CT, switching the bank at c.
New capacitor.cb2 phases=3 bus1=c conn=wye kvar=600 kv=12.47
New capcontrol.ci element=line.lt terminal=1 capacitor=cb2 type=current
~ ctratio=1 ctphase=3 onsetting=110 offsetting=60 eventlog=yes

New loadshape.day npts=24 interval=1
~ mult=(0.30 0.32 0.35 0.42 0.52 0.68 0.82 0.96 1.10 1.20 1.25 1.18 1.08 0.98 0.88 0.78 0.70 0.76 0.92 1.06 1.16 0.88 0.55 0.35)

! Per-phase-unequal loads (phase 3 heaviest -> drives the phase-3 CT).
New load.la bus1=c.1 phases=1 conn=wye model=1 kv=7.2 kw=900 pf=0.88 daily=day
New load.lb bus1=c.2 phases=1 conn=wye model=1 kv=7.2 kw=350 pf=0.95 daily=day
New load.lc bus1=c.3 phases=1 conn=wye model=1 kv=7.2 kw=1400 pf=0.85 daily=day

Set voltagebases=[12.47]
calcv
Set mode=daily stepsize=1h number=1
