// UPFC mode 2 (StatCOM / reactive-power compensation) + the UPFCControl wrapper
// (UPFC.pas GetInputCurr ModeUPFC=2, l.787-795: the series path is OFF -
// GetOutputCurr mode 2 is CurrOut:=0 - and the device instead injects a SHUNT
// reactive current at Bus1 sized from CalcUPFCPowers(2)=StatCOM and the target
// power factor `pf`, QIdeal = Q_UPFC - sqrt(1-pf^2)*|P|/pf, clamped to
// kvarLimit). CheckStatus mode 2 is checkPF() ONLY (UPFC.pas l.936-937), so the
// UPFC MUST have `Element=` set for the control to ever fire - here it monitors
// the input-side service transformer and drives that element's PF toward
// pf=0.95. The mode-2 control needs a bounded/reachable target to settle
// (pf=0.99 hits max-control-iterations here - the kvarLimit clamp stops MonPF
// short of target so checkPF never clears); pf=0.95 with kvarLimit=20 lands the
// monitored PF inside tol1 (QIdeal ~3.1 kvar, unclamped) and converges in 16
// iters. Because the series path is off, Sr0 stays 0 (no series-injection V)
// and Vbout floats - the signature is purely the QIdeal shunt current. Compared
// per step: full model (the shunt-injected V/I) + all 14 UPFC state variables +
// mode/pf/element probes.
//
// Feature-sensitive (probe-proven, pinned oracle): mode=0 (off) zeros QIdeal and
// the shunt injection (monitored PF stays at its natural ~0.91); changing pf
// (0.90/0.95/0.99) each moves QIdeal and the monitored PF to a distinct value.
clear
Set DefaultBaseFrequency=60

New circuit.upfcstatcom bus1=source_bus.1.0 phases=1 basekv=7.2 pu=1 angle=0
~ mvasc3=2000000 mvasc1=20000000

New xycurve.losses npts=3 xarray=[0.9 1 1.1] yarray=[1.0143 1.008 1.0143]

New xfmrcode.1-ph50kva-2 phases=1 windings=2 ppm=0 xhl=2.04 %noloadloss=.02
~ kvs=[7.2 0.24] kvas=[50 50] %rs=[0.9 0.9] conns=[wye wye]

New xfmrcode.upfcinterface phases=1 windings=3 ppm=0 xhl=.0204 xht=.0204
~ xlt=.0136 %noloadloss=.01 kvs=[0.24 0.12 0.12] kvas=[50 50 50]
~ %rs=[0.006 .012 .012] conns=[wye wye wye]

New transformer.service50kva xfmrcode=1-ph50kva-2 buses=[source_bus.1.0 upfc_input.1]

// mode 2: shunt reactive compensation; monitors the service transformer PF.
New upfc.test phases=1 bus1=upfc_input.1 bus2=upfc_output.1 mode=2
~ losscurve=losses tol1=0.005 xs=0.02 pf=0.95 kvarlim=20
~ element=Transformer.service50kva

New upfccontrol.myupfcctrl

New transformer.tupfcout xfmrcode=upfcinterface
~ buses=[upfc_output.1.0 load_bus.1.0 load_bus.0.2]

New load.load120a phases=1 model=1 bus1=load_bus.1.0 kv=0.12 kw=14.98 kvar=10.08
New load.load120b phases=1 model=1 bus1=load_bus.2.0 kv=0.12 kw=12.38 kvar=1.71

Set voltagebases=[12.47 .415 0.208]
calcv
Set tolerance=1e-12
Set maxiterations=100
Set maxcontroliter=30
