// Monitor modes scenario: four monitors in deterministic modes on one small
// circuit — mode 0 (V/I) on the feeder, mode 1 (powers) on the load, mode 2
// (tap position) on the regulated transformer, mode 3 (state variables) on a
// discharging Storage. A daily ramp moves everything (taps step, storage
// depletes) so every channel carries a varying trajectory. Headers, sample
// counts, and all channel arrays are compared per step (check_meters_monitors).
clear
Set DefaultBaseFrequency=60

new circuit.mon basekv=115 pu=1.03 phases=3 bus1=src mvasc3=15000 mvasc1=12000

new transformer.tr phases=3 windings=2 buses=(src, mv) conns=(delta, wye)
~ kvs=(115, 12.47) kvas=(10000, 10000) xhl=7
new regcontrol.rg transformer=tr winding=2 vreg=122 band=1.5 ptratio=60
~ eventlog=yes

new line.feed bus1=mv bus2=b r1=0.2 x1=0.5 r0=0.5 x0=1.3 c1=0 c0=0 length=1

new loadshape.day npts=12 interval=1
~ mult=(0.35 0.50 0.70 0.90 1.10 1.25 1.20 1.05 0.85 0.65 0.50 0.40)

new load.l1 bus1=b phases=3 kv=12.47 kw=6000 pf=0.92 model=1 daily=day

new storage.s1 bus1=b phases=3 kv=12.47 kwrated=800 kva=800 kwhrated=3200
~ %stored=90 %idlingkw=1 state=discharging %discharge=100 pf=1.0

new monitor.m0 element=line.feed terminal=1 mode=0
new monitor.m1 element=load.l1 terminal=1 mode=1
new monitor.m2 element=transformer.tr terminal=2 mode=2
new monitor.m3 element=storage.s1 terminal=1 mode=3

set voltagebases=[115 12.47]
calcvoltagebases
set mode=daily stepsize=1h number=1
