// GENERATED by tools/decks/gen_midi_decks.py -- do not hand-edit; regenerate.
// The IEEE123-class midi network: see the generator docstring for the design
// rationale (controls-daily variant).
clear
Set DefaultBaseFrequency=60

new circuit.midi basekv=115 pu=1.03 angle=0 phases=3 bus1=src
~ mvasc3=15000 mvasc1=12000

! FULL asymmetric matrix inputs (pin the ParseAsSymMatrix lower-triangle-wins
! overwrite order at scale).
new linecode.lca nphases=3 units=kft
~ rmatrix=[0.087 0.029 0.028 | 0.031 0.089 0.030 | 0.027 0.032 0.087]
~ xmatrix=[0.203 0.085 0.072 | 0.088 0.196 0.083 | 0.070 0.086 0.202]
~ cmatrix=[2.74 -0.70 -0.34 | -0.72 2.96 -0.71 | -0.33 -0.69 2.74]
new linecode.lcc nphases=3 units=kft
~ rmatrix=[0.095 0.033 0.025 | 0.036 0.098 0.034 | 0.028 0.037 0.094]
~ xmatrix=[0.215 0.092 0.078 | 0.096 0.208 0.090 | 0.075 0.093 0.212]
~ cmatrix=[2.55 -0.62 -0.30 | -0.66 2.80 -0.64 | -0.31 -0.60 2.52]
new linecode.lcb2 nphases=2 units=kft
~ rmatrix=[0.091 0.030 | 0.034 0.093]
~ xmatrix=[0.210 0.090 | 0.095 0.205]
~ cmatrix=[2.60 -0.60 | -0.65 2.55]
new linecode.lc1 nphases=1 r1=0.095 x1=0.21 c1=3.0 units=kft

! Substation: Dy 115/12.47 (the LTC in the controls variant).
new transformer.sub phases=3 windings=2 buses=(src, bb1) conns=(delta, wye)
~ kvs=(115, 12.47) kvas=(20000, 20000) xhl=7
new line.bb1_2 bus1=bb1 bus2=bb2 linecode=lca length=2 units=kft
new line.bb2_3 bus1=bb2 bus2=bb3 linecode=lca length=3 units=kft
new line.bb3_4 bus1=bb3 bus2=bb4 linecode=lca length=2 units=kft
new line.bb4_5 bus1=bb4 bus2=bb5 linecode=lca length=4 units=kft
new line.bb5_6 bus1=bb5 bus2=bb6 linecode=lcc length=3 units=kft
new line.bb6_7 bus1=bb6 bus2=bb7 linecode=lca length=2 units=kft
new line.bb7_8 bus1=bb7 bus2=bb8 linecode=lca length=3 units=kft
! Backbone segment 8: the Z1<>Z2 series reactor (the
! non-reciprocal-YPrim class of the 03c63f2 stamp bug) mid-chain.
new reactor.rser phases=3 bus1=bb8 bus2=bb9
~ Z1=[0.35 0.62] Z2=[0.08 0.21] Z0=[0.5 0.9]
new line.bb9_10 bus1=bb9 bus2=bb10 linecode=lca length=4 units=kft
new line.bb10_11 bus1=bb10 bus2=bb11 linecode=lcc length=2 units=kft
new line.bb11_12 bus1=bb11 bus2=bb12 linecode=lca length=3 units=kft
new line.bb12_13 bus1=bb12 bus2=bb13 linecode=lca length=2 units=kft
new line.bb13_14 bus1=bb13 bus2=bb14 linecode=lca length=3 units=kft
new line.bb14_15 bus1=bb14 bus2=bb15 linecode=lca length=2 units=kft
! Parallel line on segment 5 (duplicate stamps on the same node pair).
new line.bb5_6p bus1=bb5 bus2=bb6 linecode=lcc length=4 units=kft

! Mid-feeder 1-phase regulating bank bb10 -> rb (per-phase-unequal
! FIXED taps in the asym variant; RegControls in the controls variant).
new transformer.rbank1 phases=1 windings=2 buses=(bb10.1, rb.1) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2500, 2500) xhl=1 taps=[1.0 1.0]
new transformer.rbank2 phases=1 windings=2 buses=(bb10.2, rb.2) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2500, 2500) xhl=1 taps=[1.0 1.0]
new transformer.rbank3 phases=1 windings=2 buses=(bb10.3, rb.3) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2500, 2500) xhl=1 taps=[1.0 1.0]
! The backbone continues from the regulated bus.
new line.rb_bb11 bus1=rb bus2=bb11 linecode=lca length=2 units=kft

! --- Laterals: mixed 3ph/2ph/1ph, a loop, cascaded voltage levels ---
! L1 @bb2: 3-phase, 2 segments.
new line.l1a bus1=bb2 bus2=l1m linecode=lca length=3 units=kft
new line.l1b bus1=l1m bus2=l1e linecode=lcc length=2 units=kft
! L2 @bb3: 1-phase (phase 2), 2 segments.
new line.l2a phases=1 bus1=bb3.2 bus2=l2m.2 linecode=lc1 length=2 units=kft
new line.l2b phases=1 bus1=l2m.2 bus2=l2e.2 linecode=lc1 length=2 units=kft
! L3 @bb4: 2-phase (phases 1,3), 2 segments.
new line.l3a phases=2 bus1=bb4.1.3 bus2=l3m.1.3 linecode=lcb2 length=2 units=kft
new line.l3b phases=2 bus1=l3m.1.3 bus2=l3e.1.3 linecode=lcb2 length=2 units=kft
! L4 @bb5: 3-phase, 3 segments (loops to L6's end below).
new line.l4a bus1=bb5 bus2=l4m linecode=lca length=3 units=kft
new line.l4b bus1=l4m bus2=l4n linecode=lca length=2 units=kft
new line.l4c bus1=l4n bus2=l4e linecode=lcc length=2 units=kft
! L5 @bb7: 1-phase (phase 1) + a 1-phase service transformer spur.
new line.l5a phases=1 bus1=bb7.1 bus2=l5m.1 linecode=lc1 length=2 units=kft
new transformer.t5 phases=1 windings=2 buses=(l5m.1, l5lv.1) conns=(wye, wye)
~ kvs=(7.2, 0.277) kvas=(167, 167) xhl=2.3
! L6 @bb12: 3-phase, 3 segments; its end ties back to L4's end -> LOOP.
new line.l6a bus1=bb12 bus2=l6m linecode=lca length=3 units=kft
new line.l6b bus1=l6m bus2=l6n linecode=lcc length=2 units=kft
new line.l6c bus1=l6n bus2=l6e linecode=lca length=2 units=kft
new line.tie bus1=l4e bus2=l6e switch=yes
! L7 @bb13: 2-phase (phases 2,3).
new line.l7a phases=2 bus1=bb13.2.3 bus2=l7e.2.3 linecode=lcb2 length=3 units=kft
! L8 @bb14: 3-winding step-down 12.47/4.16/0.48 (delta tertiary; the
! tertiary bus is pinned physically — the proven ppm-antifloat
! common-mode floor, never a tolerance dodge).
new transformer.t8 phases=3 windings=3 buses=(bb14, l8mv, l8lv)
~ conns=(wye, delta, wye) kvs=(12.47, 0.48, 4.16) kvas=(5000, 3000, 2000)
~ xhl=6 xht=5 xlt=3
new capacitor.cpin8 phases=3 bus1=l8mv conn=wye kvar=25 kv=0.48
! L9 @bb15 (feeder end): the DER pocket.
new line.l9a bus1=bb15 bus2=l9e linecode=lca length=2 units=kft

! --- Shunt asymmetries ---
! FULL asymmetric cmatrix bank at bb6.
new capacitor.cmat phases=3 bus1=bb6
~ cmatrix=[3.2 -0.9 -0.3 | -0.5 3.5 -0.7 | -0.4 -1.1 3.1]
! Delta bank at bb13.
new capacitor.cdel phases=3 bus1=bb13 conn=delta kvar=300 kv=12.47
! 1-phase shunt reactor on bb4 phase 3.
new reactor.rsh phases=1 bus1=bb4.3 kvar=120 kv=7.2

! --- DER pocket at the feeder end ---
! pv3 is wye: WP-U1.3 row D4 makes a DELTA controlled DER monitor line-to-line
! voltages (a capi015/r4133 behavior); this deck stays 0.14.5-gated (its
! CapControl/RegControl/StorageController carry unported U1.5/U1.6 deltas, so it
! cannot flip to capi015), and the multi-step capi015 oracle cannot gate a
! time-series deck anyway. The delta-DER-under-InvControl (D4) coverage lives in
! the dedicated capi015 snapshot deck invcontrol/invcontrol_vv_delta.dss.
new pvsystem.pv3 phases=3 bus1=l9e conn=wye kv=12.47 kva=600 pmpp=500
~ irradiance=0.9 pf=0.98
new pvsystem.pv1 phases=1 bus1=l6m.2 kv=7.2 kva=150 pmpp=120 irradiance=0.85 pf=1
new storage.st1 phases=3 bus1=l9e kv=12.47 kwrated=400 kva=400 kwhrated=1600
~ %stored=75 %idlingkw=0 pf=1.0
new generator.g1 phases=3 bus1=l4m conn=wye model=1 kv=12.47 kw=500 pf=0.95
~ vminpu=0.8

! --- The control layer (cascaded regulators + caps + DER controls) ---
new regcontrol.ltc transformer=sub winding=2 vreg=123 band=2 ptratio=60
~ eventlog=yes
new regcontrol.rga transformer=rbank1 winding=2 vreg=119 band=2 ptratio=60
~ eventlog=yes
new regcontrol.rgb transformer=rbank2 winding=2 vreg=119 band=2 ptratio=60
~ eventlog=yes
new regcontrol.rgc transformer=rbank3 winding=2 vreg=119 band=2 ptratio=60
~ eventlog=yes
! kvar-mode CapControls: voltage mode under two cascaded regulators hunts
! (the LTC/bank mask the excursions -- the combo_voltvar_asym lesson). The
! ON/OFF deadband must exceed the bank's own kvar (600 for cdel), else the
! control hunts when the load kvar lands inside the bank-sized window.
new capcontrol.ccv element=line.bb1_2 terminal=1 capacitor=cmat type=kvar
~ onsetting=2000 offsetting=1150 eventlog=yes
new capcontrol.cck element=line.bb12_13 terminal=1 capacitor=cdel type=kvar
~ onsetting=450 offsetting=150 eventlog=yes
new xycurve.vv npts=5 yarray=(1 1 0 -1 -1) xarray=(0.5 0.92 1.0 1.08 1.5)
new invcontrol.ic mode=VOLTVAR voltage_curvex_ref=rated vvc_curve1=vv
~ deltaq_factor=0.2 refreactivepower=VARMAX
new storagecontroller.sc element=line.bb1_2 terminal=1 modedis=peakshave
~ monphase=avg kwtarget=4300 %reserve=20 eventlog=yes

! --- Metering layer ---
new energymeter.em element=transformer.sub terminal=1
new monitor.m0 element=line.bb5_6 terminal=1 mode=0
new monitor.m2 element=transformer.rbank1 terminal=2 mode=2
new monitor.m3 element=storage.st1 terminal=1 mode=3
new sensor.sn element=line.bb1_2 terminal=1 kvbase=7.2 conn=wye
~ currents=[250 180 300]

