// Fuse, r4133 CurveMultiplier divisor (WP-U2.1, delta C3/D1): an SLG fault on
// phase 2 melts ONLY that phase's link through an EXPLICIT `fusecurve=tlink`
// scaled by `curvemultiplier=40` (the new TCC divisor — `GetTCCTime(Cmag/40)`,
// NOT the now-informational `RatedCurrent`). Feature-sensitive to the divisor:
// `curvemultiplier=40` gives the clean single-phase blow at Sec=0.4 (State=
// [closed, open, closed], `PHASE 2 BLOWN`); `curvemultiplier=1` instead melts
// all three phases at Sec=0.2 (probe-proven). RatedCurrent is left at its r4133
// default 0 (informational, unused) so a port that wrongly divided by it would
// divide-by-zero and blow every phase instantly — this deck pins that the
// divisor is CurveMultiplier. r4133-only (`curvemultiplier` is an r4133
// property). Compared per step: full model + per-phase State/Normal probes +
// blow event log.
clear
Set DefaultBaseFrequency=60

new circuit.prot basekv=12.47 phases=3 bus1=src mvasc3=20000 mvasc1=21000
new linecode.lc nphases=3 r1=0.3 x1=0.6 r0=0.7 x0=1.9 c1=0 c0=0 units=mi
new line.feed bus1=src bus2=mid linecode=lc length=1 units=mi
new line.lat bus1=mid bus2=loadb linecode=lc length=1 units=mi
new load.l bus1=loadb phases=3 kv=12.47 kw=500 pf=0.95 model=1

new fuse.fz monitoredobj=line.feed monitoredterm=1
~ switchedobj=line.feed switchedterm=1 fusecurve=tlink curvemultiplier=40

! SLG fault on phase 2 only -> only the phase-2 link blows (with curvemult=40).
new fault.f bus1=loadb.2 phases=1 ontime=0.1 r=0.5 temporary=no

set voltagebases=[12.47]
calcvoltagebases
set mode=duty stepsize=0.1 number=1 controlmode=time
