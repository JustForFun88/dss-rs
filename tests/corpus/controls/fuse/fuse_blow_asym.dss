// Fuse, r4133 never-blows (WP-U2.1, delta D1): historically an asymmetric
// single-line-to-ground blow deck (default `tlink` curve, RatedCurrent-scaled).
// On r4133 the default FuseCurve moved `tlink` -> `none`, so this fuse (no
// explicit curve) NEVER blows: State stays [closed, closed, closed], the blow
// event log + control queue are empty (a ctrlqueue action of 1 on 0.14.5). Pins
// the breaking never-blows default; the CurveMultiplier-scaled asymmetric blow
// now lives in the sibling `fuse_curvemult_blow` deck. Gated `oracle:"r4133"`.
// Compared per step: full model + per-phase State/Normal probes + event log.
clear
Set DefaultBaseFrequency=60

new circuit.prot basekv=12.47 phases=3 bus1=src mvasc3=20000 mvasc1=21000
new linecode.lc nphases=3 r1=0.3 x1=0.6 r0=0.7 x0=1.9 c1=0 c0=0 units=mi
new line.feed bus1=src bus2=mid linecode=lc length=1 units=mi
new line.lat bus1=mid bus2=loadb linecode=lc length=1 units=mi
new load.l bus1=loadb phases=3 kv=12.47 kw=500 pf=0.95 model=1

new fuse.fz monitoredobj=line.feed monitoredterm=1
~ switchedobj=line.feed switchedterm=1 ratedcurrent=40

! SLG fault on phase 2 only -> only the phase-2 link blows.
new fault.f bus1=loadb.2 phases=1 ontime=0.1 r=0.5 temporary=no

set voltagebases=[12.47]
calcvoltagebases
set mode=duty stepsize=0.1 number=1 controlmode=time
