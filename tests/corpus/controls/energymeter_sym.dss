// EnergyMeter symmetric scenario: a meter at the feeder head over a two-line
// zone with balanced daily loads whose peak overloads the feeder line's
// normamps rating — the kWh / losses / max-kW / OVERLOAD registers all
// accumulate, and the zone (branches / ends / PCE membership) is compared.
// Daily 24 steps, check_meters_monitors.
clear
Set DefaultBaseFrequency=60

new circuit.emsym basekv=12.47 phases=3 bus1=src mvasc3=20000 mvasc1=21000

! Low normamps so the daily peak drives the overload registers.
new line.feed bus1=src bus2=m1 r1=0.3 x1=0.6 r0=0.7 x0=1.9 c1=0 c0=0 length=1
~ normamps=150 emergamps=200
new line.lat bus1=m1 bus2=m2 r1=0.3 x1=0.6 r0=0.7 x0=1.9 c1=0 c0=0 length=1

new loadshape.day npts=24 interval=1
~ mult=(0.40 0.42 0.45 0.50 0.58 0.68 0.80 0.92 1.02 1.10 1.15 1.18 1.20 1.15 1.08 1.00 0.92 0.88 0.95 1.05 1.10 0.90 0.65 0.45)

new load.l1 bus1=m1 phases=3 kv=12.47 kw=2500 pf=0.95 model=1 daily=day
new load.l2 bus1=m2 phases=3 kv=12.47 kw=1800 pf=0.92 model=1 daily=day

new energymeter.em element=line.feed terminal=1

set voltagebases=[12.47]
calcvoltagebases
set mode=daily stepsize=1h number=1
