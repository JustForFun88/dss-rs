// RegControl symmetric scenario (CONTROL_COVERAGE_PLAN.md): a 3-phase LTC
// (delta-wye substation transformer + RegControl on winding 2) under a daily
// balanced load ramp that forces tap movement in both directions over 24
// steps. Compared per step: full model + transformer taps + RegControl
// TapNumber (discrete), RegControl/Transformer property probes, and the
// cumulative event log (tap-change actions).
clear
Set DefaultBaseFrequency=60

New circuit.regsym basekv=115 pu=1.03 angle=0 phases=3 bus1=src
~ mvasc3=15000 mvasc1=12000

New transformer.tr phases=3 windings=2 buses=(src, mv) conns=(delta, wye)
~ kvs=(115, 12.47) kvas=(10000, 10000) xhl=7

New regcontrol.rg transformer=tr winding=2 vreg=122 band=1.5 ptratio=60
~ eventlog=yes

New loadshape.day npts=24 interval=1
~ mult=(0.30 0.35 0.45 0.55 0.70 0.85 1.00 1.10 1.20 1.28 1.30 1.25 1.15 1.00 0.85 0.70 0.60 0.75 0.95 1.10 1.20 0.95 0.60 0.35)

New load.l1 bus1=mv phases=3 conn=wye model=1 kv=12.47 kw=7000 pf=0.92
~ daily=day

Set voltagebases=[115 12.47]
calcv
Set mode=daily stepsize=1h number=1
