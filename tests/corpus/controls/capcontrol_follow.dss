! GAPS deck: CapControl type=Follow + ControlSignal (LoadShape) — deterministic.
! The Follow control switches the capacitor per the 0/1 control-signal shape
! over a daily run; gate pins step states + the event log.
Clear
New Circuit.gaps_ccf basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Loadshape.day8 npts=8 interval=3 mult=(0.40 0.55 0.75 0.95 1.00 0.90 0.70 0.50)
New Loadshape.sig npts=8 interval=3 mult=(0 0 1 1 1 1 0 0)
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=900 pf=0.90 model=1 daily=day8
New Capacitor.c1 bus1=b1 phases=3 kvar=300 kv=12.47
New CapControl.cc element=Line.l1 terminal=1 capacitor=c1 type=Follow ControlSignal=sig eventlog=yes
Set voltagebases=[12.47]
Calcvoltagebases
Set mode=daily stepsize=1h number=24
Solve
