// RegControl remote regulated bus (RegControl.pas: UsingRegulatedBus, set by
// the `bus=` property; Sample l.1005-1017 reads the named remote bus voltage
// via GetControlVoltage with RemotePTRatio instead of the transformer's own
// terminal). The regulator watches a bus one line-section downstream of the
// LTC, so it taps to hold the REMOTE node in band (the local terminal runs
// higher by the intervening line drop). Feature-sensitive: dropping the remote
// bus (regulating the local winding) lands on a different tap trajectory
// because the two nodes differ by the daily-varying line drop (probe-proven).
// Compared per step: full model + taps + TapNumber + probes + event log + CQ.
clear
Set DefaultBaseFrequency=60

New circuit.regremote basekv=115 pu=1.03 angle=0 phases=3 bus1=src
~ mvasc3=15000 mvasc1=12000

New transformer.tr phases=3 windings=2 buses=(src, mv) conns=(delta, wye)
~ kvs=(115, 12.47) kvas=(10000, 10000) xhl=7

// Feeder section between the LTC terminal (mv) and the regulated load bus.
New line.feeder bus1=mv bus2=load phases=3 r1=0.35 x1=0.9 r0=1.0 x0=2.7
~ c1=0 c0=0 length=5 units=km

New regcontrol.rg transformer=tr winding=2 vreg=122 band=1.5
~ bus=load remoteptratio=60 eventlog=yes

New loadshape.day npts=24 interval=1
~ mult=(0.30 0.35 0.45 0.55 0.70 0.85 1.00 1.10 1.20 1.28 1.30 1.25 1.15 1.00 0.85 0.70 0.60 0.75 0.95 1.10 1.20 0.95 0.60 0.35)

New load.l1 bus1=load phases=3 conn=wye model=1 kv=12.47 kw=6000 pf=0.92
~ daily=day

Set voltagebases=[115 12.47]
calcv
Set mode=daily stepsize=1h number=1
