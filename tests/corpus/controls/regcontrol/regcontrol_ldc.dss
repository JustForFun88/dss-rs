// RegControl line-drop compensation (LDC forward path). A 3-phase LTC with
// R+jX line-drop compensation set (RegControl.pas Sample l.1040-1048: ILDC =
// Iterm/CTRating, Vcontrol := Vcontrol + Cmplx(R,X)*ILDC). The R/X drop shifts
// the effective control voltage as load current swings over a daily ramp, so
// the tap trajectory differs from a bare-Vreg regulator (feature-sensitive:
// neutralizing r=0 x=0 changes the tap event log — probe-proven).
// Compared per step: full model + transformer taps + RegControl TapNumber
// (discrete), property probes, and the tap-change event log / control queue.
clear
Set DefaultBaseFrequency=60

New circuit.regldc basekv=115 pu=1.03 angle=0 phases=3 bus1=src
~ mvasc3=15000 mvasc1=12000

New transformer.tr phases=3 windings=2 buses=(src, mv) conns=(delta, wye)
~ kvs=(115, 12.47) kvas=(10000, 10000) xhl=7

New regcontrol.rg transformer=tr winding=2 vreg=122 band=1.5 ptratio=60
~ ctprim=300 r=3 x=9 eventlog=yes

New loadshape.day npts=24 interval=1
~ mult=(0.30 0.35 0.45 0.55 0.70 0.85 1.00 1.10 1.20 1.28 1.30 1.25 1.15 1.00 0.85 0.70 0.60 0.75 0.95 1.10 1.20 0.95 0.60 0.35)

New load.l1 bus1=mv phases=3 conn=wye model=1 kv=12.47 kw=7000 pf=0.92
~ daily=day

Set voltagebases=[115 12.47]
calcv
Set mode=daily stepsize=1h number=1
