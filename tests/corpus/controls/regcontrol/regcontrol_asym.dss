// RegControl asymmetric scenario: a bank of three 1-phase regulating
// transformers (IEEE13 reg1a/b/c pattern), each with its own RegControl, under
// per-phase-UNEQUAL daily load ramps — the three taps move independently.
// Compared per step: full model + per-phase taps/TapNumber (discrete), probes,
// and the interleaved tap-change event log.
clear
Set DefaultBaseFrequency=60

New circuit.regasym basekv=12.47 pu=1.02 angle=0 phases=3 bus1=src
~ mvasc3=2000 mvasc1=2100

New line.lf bus1=src bus2=b r1=0.2 x1=0.5 r0=0.5 x0=1.2 c1=0 c0=0 length=2

New transformer.rega phases=1 windings=2 buses=(b.1, m.1) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2000, 2000) xhl=1
New regcontrol.rga transformer=rega winding=2 vreg=122 band=2 ptratio=60
~ eventlog=yes

New transformer.regb phases=1 windings=2 buses=(b.2, m.2) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2000, 2000) xhl=1
New regcontrol.rgb transformer=regb winding=2 vreg=122 band=2 ptratio=60
~ eventlog=yes

New transformer.regc phases=1 windings=2 buses=(b.3, m.3) conns=(wye, wye)
~ kvs=(7.2, 7.2) kvas=(2000, 2000) xhl=1
New regcontrol.rgc transformer=regc winding=2 vreg=122 band=2 ptratio=60
~ eventlog=yes

New loadshape.day npts=12 interval=1
~ mult=(0.30 0.45 0.65 0.85 1.05 1.20 1.10 0.95 0.75 0.55 0.40 0.30)

! Per-phase-unequal loads -> the three regulators land on different taps.
New load.la bus1=m.1 phases=1 conn=wye model=1 kv=7.2 kw=1500 pf=0.9 daily=day
New load.lb bus1=m.2 phases=1 conn=wye model=1 kv=7.2 kw=500 pf=0.95 daily=day
New load.lc bus1=m.3 phases=1 conn=wye model=1 kv=7.2 kw=1900 pf=0.88 daily=day

Set voltagebases=[12.47]
calcv
Set mode=daily stepsize=1h number=1
