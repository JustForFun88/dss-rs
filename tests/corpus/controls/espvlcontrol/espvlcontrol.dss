// ESPVLControl scenario: an Energy-Storage/PV "system controller" supervising a
// fleet of "local controllers" over a daily ramp whose feeder-head power crosses
// the hardcoded FkWLimit = 8000 kW (ESPVLControl.pas:321 -- there is NO kWLimit
// property), so |PDiff| > HalfkWBand on both sides.
//
// WHAT THIS DECK ACTUALLY GATES vs WHAT IS ONLY UNIT-PINNED (measured, G1.2 audit
// settlement 2026-08-29). A 12-step mutation run on the pinned oracle -- 405
// compared cells per step (every property of every element, all bus voltages,
// iterations, ControlIterations, the event log and the control queue) with
// `kWBand=1e9` on sys+scan so the redispatch loop can never fire -- differs from
// the base run in exactly the 24 mutated `kWBand` cells and NOTHING else. So the
// redispatch arithmetic (PDiff, HalfkWBand, the weights, TotalWeight, the
// Max(1.0,..) floor) and `sys`'s NAMED-list branch are UNOBSERVABLE on every
// oracle channel: upstream writes them onto a type-confused TGeneratorObj field
// of another ESPVLControl, and the port writes its `phantom_kw_base`. Their
// regression net is elements/control/espvl_control/tests.rs +
// exec/tests/espvl_control.rs, NOT this deck.
//
// What this deck does gate live, per step, on capi_v0145:
//   * `scan.LocalControlWeights` '' -> '[ 1 1 1 1 1]' -- the one Sample-derived
//     observable in the class. MakeLocalControlList's no-list branch sweeps the
//     WHOLE ESPVLControl class for ENABLED controls (ESPVLControl.pas:609-611 --
//     the sweep is type-blind, it takes local, system and untyped alike) and
//     allocates uniform weights, so the readback is a live product of Sample and
//     its LENGTH is a two-sided assertion on the enabled-filter.
//   * the full 14-property table of all five controls (compare_all_properties is
//     force-enabled for the controls family on the capi channel), incl. the ''
//     rendering of an unset `Type` and the dead PVSystem/Storage lists.
//   * the no-op contract: two real generators whose kw/kvar must hold their input
//     bases, an EMPTY event log, and an EMPTY control queue -- all compared, so a
//     port that dispatched the generators or queued an action fails here.
//
// The four ESPVLControl instantiation shapes, all present:
//   sys   -- Type=SystemController with a named LocalControlList + weights [3,1]
//            (parse round-trip only; the branch itself is unobservable);
//   scan  -- Type=SystemController with NO list -> the class sweep above;
//   loc1  -- Type=LocalController naming a PVSystem + a Storage; upstream never
//            resolves those pointer lists, so they round-trip only;
//   loc2  -- the same with the weights left at their defaults;
//   plain -- no `type=` at all (Ftype=0): `Type` dumps '', MakeLocalControlList
//            returns false at its Ftype gate (ESPVLControl.pas:595) and Sample is
//            a no-op -- while the control still counts as ENABLED in scan's sweep;
//   off   -- an explicitly disabled control, so the sweep's "enabled only" filter
//            is observable (off is NOT in scan's fleet of five).
//
// UPSTREAM PROCESS CONTAMINATION (measured 2026-08-29; the reason the manifest row
// sets `isolate: true`). ESPVLControl is a no-op on every observable state of THIS
// compiled deck, but a SystemController's Sample corrupts the pinned oracle's
// GLOBAL process state: after even ONE solve, a later `compile <deck>` leaves
// NumCircuits=0 with Error.Number=0 and every API call raises "(#8888) There is no
// active circuit!". Isolated: no solve -> clean; all controls disabled -> clean;
// only the LocalControllers enabled -> clean; `sys` alone with kWBand=1e9 (no
// redispatch) -> STILL broken. So it is the SystemController Sample /
// MakeLocalControlList path, not the type-confused kWBase write. A top-level
// `clear` before the next Compile heals it, which is why the gate never saw this.
//
// Deliberately no `MakePosSequence`: the ESPVLControl override dereferences the
// always-NIL ControlledElement and aborts the oracle (docs/wpg21_makeposseq_probes.md,
// makeposseq_ctrl.dss:9-13).
clear
Set DefaultBaseFrequency=60

New circuit.espvl basekv=12.47 phases=3 bus1=src basefreq=60

New line.l1 bus1=src bus2=b1 length=1 r1=0.3 x1=0.6

New loadshape.day npts=12 interval=1
~ mult=(0.40 0.55 0.72 0.88 1.00 1.12 1.20 1.08 0.92 0.78 0.62 0.46)

New load.ld1 bus1=b1 phases=3 kv=12.47 kw=9000 pf=0.95 daily=day

New generator.g1 bus1=b1 phases=3 kv=12.47 kw=600 pf=1.0 model=1
New generator.g2 bus1=b1 phases=3 kv=12.47 kw=400 pf=0.90 model=1

New pvsystem.pv1 bus1=b1 phases=3 kv=12.47 pmpp=500 kva=600 irradiance=1.0
New storage.st1 bus1=b1 phases=3 kv=12.47 kwrated=250 kwhrated=1000 state=IDLING

// Local controllers: dead PVSystem/Storage lists (round-trip only upstream).
New espvlcontrol.loc1 element=line.l1 terminal=1 type=LocalController
~ PVSystemList=[pv1] PVSystemWeights=[1] StorageList=[st1] StorageWeights=[1]
New espvlcontrol.loc2 element=line.l1 terminal=1 type=LocalController
~ PVSystemList=[pv1] StorageList=[st1]

// A disabled control: the `scan` system controller's class sweep keeps enabled
// controls only, so `off` never joins its fleet.
New espvlcontrol.off element=line.l1 terminal=1 type=LocalController enabled=no

// No `type=` at all -> Ftype = 0: `Type` dumps '', Sample no-ops at the Ftype
// gate, but the control IS enabled, so scan's type-blind sweep still counts it.
New espvlcontrol.plain element=line.l1 terminal=1

// System controller over the NAMED fleet, unequal weights.
New espvlcontrol.sys element=line.l1 terminal=1 type=SystemController kWBand=200
~ kvarLimit=1500 LocalControlList=[loc1, loc2] LocalControlWeights=[3, 1]

// System controller with NO list: scans the whole class for enabled controls.
New espvlcontrol.scan element=line.l1 terminal=1 type=SystemController kWBand=200

Set voltagebases=[12.47]
calcv
Set mode=daily stepsize=1h number=1
