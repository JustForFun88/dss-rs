! GAPS deck: SolveMode=M1 (Pascal SolveMonte1), Set random=none => deterministic:
! Load.Randomize(0) sets RandomMult=1.0 for every load, every case; the mode's
! loop machinery (hour=case counter, per-case SolveSnap + monitor/meter samples)
! is pinned without consuming the RNG.
Clear
New Circuit.gaps_m1 basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=800 pf=0.95 model=1
New Load.ld2 bus1=b1 phases=1 kv=7.2 kw=120 pf=0.90 model=1
New Monitor.m_ld1 element=Load.ld1 terminal=1 mode=1 ppolar=no
New Monitor.m_v element=Line.l1 terminal=2 mode=0
New EnergyMeter.em element=Line.l1 terminal=1
Set voltagebases=[12.47]
Calcvoltagebases
Set random=none
Set mode=M1 number=5
Solve
