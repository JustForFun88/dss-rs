! GAPS deck: SolveMode=PeakDay (Pascal SolvePeakDay / Load.pas PEAKDAY arm) —
! deterministic, no RNG. Peak kW is taken as given and shaped ONLY by the load's
! daily curve + year growth; PeakDay applies NO global LoadMultiplier (that is
! the whole difference from Daily). Feature gate for the Load PEAKDAY dispatch:
! the load power MUST follow day8 (0.40..1.00), not sit flat at nominal kW.
Clear
New Circuit.gaps_peakday basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Loadshape.day8 npts=8 interval=3 mult=(0.40 0.55 0.75 0.95 1.00 0.90 0.70 0.50)
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=900 pf=0.95 model=1 daily=day8
New Monitor.m_ld1 element=Load.ld1 terminal=1 mode=1 ppolar=no
New EnergyMeter.em element=Line.l1 terminal=1
Set voltagebases=[12.47]
Calcvoltagebases
! LoadMultiplier deliberately set != 1 to prove PeakDay ignores it (the shape,
! not this multiplier, must drive the load power).
Set LoadMult=1.5
Set mode=peakday stepsize=3h number=8
Solve
