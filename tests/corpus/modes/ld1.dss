! GAPS deck: SolveMode=LD1 (Pascal SolveLD1) — deterministic, no RNG.
! Daily loop (NDaily = 24*3600/h outer steps) x LoadDurCurve points inner loop;
! LoadMultiplier from the LD curve, IntervalHrs from its PresentInterval,
! DefaultHourMult from the default daily shape. Requires Set LDCurve=.
Clear
New Circuit.gaps_ld1 basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Loadshape.ldc npts=4 interval=1 mult=(1.00 0.85 0.60 0.35)
New Loadshape.day8 npts=8 interval=3 mult=(0.40 0.55 0.75 0.95 1.00 0.90 0.70 0.50)
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=900 pf=0.95 model=1 daily=day8
New Load.ld2 bus1=b1 phases=1 kv=7.2 kw=150 pf=0.90 model=1
New Monitor.m_ld1 element=Load.ld1 terminal=1 mode=1 ppolar=no
New EnergyMeter.em element=Line.l1 terminal=1
Set voltagebases=[12.47]
Calcvoltagebases
Set LDCurve=ldc
Set mode=LD1 stepsize=6h
Solve
