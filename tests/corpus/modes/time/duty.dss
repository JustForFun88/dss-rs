! GAPS corpus-coverage deck (family=modes): SolveMode=DUTYCYCLE (Pascal
! TSolutionAlgs.SolveDuty, SolutionAlgs.pas:249). The distinguishing arms vs
! GENERALTIME/DAILY:
!  * Set_Mode sets ControlMode := TIMEDRIVEN and DynaVars.h := 1.0 (a 1-second
!    default step, set_mode.rs:99) — IntervalHrs = h/3600 is tiny, so the storage
!    %stored barely moves per step (energy = P * 1s);
!  * the load follows its `duty=` shape (CalcDutyMult) sampled at the 1-second
!    grid; pricesignal is held constant (no PriceCurve arm, unlike daily/yearly).
! Each harness `solve` runs one duty step (number=1); the 8 solves walk dc8 at
! seconds 1..8 (dblHour = n/3600).
! Feature-sensitive: flattening dc8 to 1.0 removes the per-step trajectory (the
! duty shape is what varies the injection) — proven on the oracle.
Clear
New Circuit.gaps_duty basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Loadshape.dc8 npts=8 sinterval=1 mult=(0.60 0.72 0.88 1.00 0.94 0.80 0.66 0.55)
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Line.l2 bus1=b1 bus2=b2 phases=3 r1=0.35 x1=0.95 r0=1.0 x0=2.8 c1=3.0 c0=1.5 length=1.5 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=800 pf=0.95 model=1 duty=dc8
New Load.ld2 bus1=b2 phases=3 kv=12.47 kw=400 pf=0.92 model=2 duty=dc8
New Storage.batt bus1=b2 phases=3 kv=12.47 kwrated=250 kwhrated=1000 %stored=60 state=discharging %discharge=40 dispmode=default
New Monitor.m_ld1 element=Load.ld1 terminal=1 mode=1 ppolar=no
New Monitor.m_batt element=Storage.batt terminal=1 mode=1 ppolar=no
New EnergyMeter.em element=Line.l1 terminal=1
Set voltagebases=[12.47]
Calcvoltagebases
Set mode=duty stepsize=1 number=1
