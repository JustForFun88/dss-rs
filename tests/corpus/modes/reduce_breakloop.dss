// Reduce coverage (PHASE8_PLAN WP8.7): the BREAKLOOP strategy
// (DoBreakLoops, ReduceAlgs.pas:69): at a branch flagged IsLoopedHere the
// LoopLineObj partner line is disabled (no merge) - the loop l4 (b3->b1)
// is opened.
clear
Set DefaultBaseFrequency=60

new circuit.gapsrb basekv=12.47 pu=1.0 phases=3 bus1=src
~ r1=0.4 x1=1.6 r0=1.2 x0=4.2

new linecode.lc nphases=3 r1=0.301 x1=0.667 r0=0.882 x0=2.041 c1=3.4 c0=1.6
~ units=km

new line.lfeed bus1=src bus2=b1 linecode=lc length=0.5 units=km
new line.l1 bus1=b1 bus2=b2 linecode=lc length=0.8 units=km
new line.l2 bus1=b2 bus2=b3 linecode=lc length=0.6 units=km
new line.l4 bus1=b3 bus2=b1 linecode=lc length=1.2 units=km

new load.ld2 bus1=b2 phases=3 conn=wye model=1 kv=12.47 kw=350 pf=0.93
new load.ld3 bus1=b3 phases=3 conn=wye model=1 kv=12.47 kw=420 pf=0.9

new energymeter.em element=line.lfeed terminal=1

set voltagebases=[12.47]
calcvoltagebases
Set maxiterations=100
solve

set reduceoption=breakloop
reduce
solve
