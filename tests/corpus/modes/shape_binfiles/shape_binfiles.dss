! GAPS deck: binary/2-column shape file inputs — deterministic.
! LoadShape SngFile/DblFile/PQCSVFile (+ SngFile again with interval=0, the
! (hour,mult)-pair branch — WPG.1's "port both branches"; hours 0..7 line up
! exactly with the daily solve's sample hours, so the lookup lands on the
! exact-point branch, not interpolation, on both engines), TShape SngFile,
! PriceShape DblFile, GrowthShape CSVFile. Fixture files live next to this
! deck (generated by the golden gen script; committed as fixtures).
Clear
New Circuit.gaps_binshapes basekv=12.47 phases=3 bus1=sourcebus mvasc3=200 mvasc1=210
New Loadshape.ls_sng npts=8 interval=1 sngfile=ls8.sng
New Loadshape.ls_dbl npts=8 interval=1 dblfile=ls8.dbl
New Loadshape.ls_pq npts=8 interval=1 pqcsvfile=lspq8.csv
New Loadshape.ls_sng0 npts=8 interval=0 sngfile=ls8v.sng
! ls_sng0i: anchors at hours 0,2,..,14 with full-significand mults — the daily
! solve's odd sample hours interpolate BETWEEN anchors, exercising the Pascal
! single-precision storage arithmetic (GetMultAtHourSingle) end-to-end; the
! Mean/StdDev probes pin RCD/CurveMeanAndStdDevSingle (WPG.1 audit follow-up).
New Loadshape.ls_sng0i npts=8 interval=0 sngfile=ls8vi.sng
New Tshape.t_sng npts=8 interval=1 sngfile=t8.sng
New Tshape.t_sng0 npts=8 interval=0 sngfile=t8v.sng
New Priceshape.p_dbl npts=8 interval=1 dblfile=p8.dbl
New GrowthShape.g_csv npts=4 csvfile=g4.csv
! g_csvf: Pascal DoCSVFile ignores RoundA — fractional years survive a CSV
! read (they round only via Sng/DblFile); g_sng pins the rounding side.
New GrowthShape.g_csvf npts=4 csvfile=g5.csv
New GrowthShape.g_sng npts=4 sngfile=g4s.sng
New Line.l1 bus1=sourcebus bus2=b1 phases=3 r1=0.30 x1=0.90 r0=0.9 x0=2.7 c1=3.0 c0=1.5 length=2 units=km
New Load.ld1 bus1=b1 phases=3 kv=12.47 kw=800 pf=0.95 model=1 daily=ls_sng
New Load.ld2 bus1=b1 phases=3 kv=12.47 kw=300 pf=0.92 model=1 daily=ls_pq
New Load.ld3 bus1=b1 phases=3 kv=12.47 kw=200 pf=0.9 model=1 daily=ls_sng0
New Load.ld4 bus1=b1 phases=3 kv=12.47 kw=150 pf=0.93 model=1 daily=ls_sng0i
New Monitor.m_ld1 element=Load.ld1 terminal=1 mode=1 ppolar=no
New Monitor.m_ld2 element=Load.ld2 terminal=1 mode=1 ppolar=no
New Monitor.m_ld3 element=Load.ld3 terminal=1 mode=1 ppolar=no
New Monitor.m_ld4 element=Load.ld4 terminal=1 mode=1 ppolar=no
Set voltagebases=[12.47]
Calcvoltagebases
Set mode=daily stepsize=1h number=8
Solve
