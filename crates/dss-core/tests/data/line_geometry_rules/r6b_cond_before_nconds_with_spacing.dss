! cond= before nconds= is refused, then spacing= and wires= fill every
! conductor: the conductor table sits ahead of NConds= in the set order.
Clear
Set DefaultBaseFrequency=60
New Circuit.lgrules basekv=12.47 phases=3 bus1=src
Set EarthModel=Carson
Redirect library.dss
New LineSpacing.sp nconds=3 nphases=3 x=[-4 0 4] h=[28 28 28] units=ft
New LineGeometry.g cond=1 nconds=3 nphases=3 spacing=sp wires=[ACSR_556_5 ACSR_556_5 ACSR_556_5]
New Line.L bus1=src.1.2.3 bus2=b.1.2.3 geometry=g length=1 units=mi
New Load.ld bus1=b phases=3 kv=12.47 kw=1000 pf=0.95
Set voltagebases=[12.47]
CalcVoltageBases
Solve
