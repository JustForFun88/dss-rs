! Script H written with cond=1.
Clear
Set DefaultBaseFrequency=60
New Circuit.lgrules basekv=12.47 phases=3 bus1=src
Set EarthModel=Carson
Redirect library.dss
New LineGeometry.g nconds=1 nphases=1
~ cond=1 wire=ACSR_556_5 x=0 h=28 units=ft
New Line.L bus1=src.1 bus2=b.1 geometry=g length=1 units=mi
New Load.ld bus1=b.1 phases=1 kv=7.2 kw=100 pf=0.95
Set voltagebases=[12.47]
CalcVoltageBases
Solve
