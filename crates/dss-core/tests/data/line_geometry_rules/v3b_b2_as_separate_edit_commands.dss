! Script B2 written as separate Edit commands, each units= a command of its own
! between one conductor's data and the next cond=.
Clear
Set DefaultBaseFrequency=60
New Circuit.lgrules basekv=12.47 phases=3 bus1=src
Set EarthModel=Carson
Redirect library.dss
New LineGeometry.g nconds=4 nphases=3 units=mm
Edit LineGeometry.g cond=1 wire=ACSR_556_5 x=-4 h=28
Edit LineGeometry.g units=m
Edit LineGeometry.g cond=2 wire=ACSR_556_5 x=0 h=28
Edit LineGeometry.g cond=3 wire=ACSR_556_5 x=4 h=28
Edit LineGeometry.g units=ft
Edit LineGeometry.g cond=4 wire=ACSR_4/0 x=0 h=24
New Line.L bus1=src.1.2.3.0 bus2=b.1.2.3.0 geometry=g length=1 units=mi
New Load.ld bus1=b phases=3 kv=12.47 kw=1000 pf=0.95
Set voltagebases=[12.47]
CalcVoltageBases
Solve
