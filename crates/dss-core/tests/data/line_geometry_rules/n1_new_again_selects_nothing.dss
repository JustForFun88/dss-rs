! A second New of an existing geometry selects no conductor and keeps the
! default unit of the earlier definition. Geometry h has one conductor, written
! after its second New without a unit, so it takes the default metres.
Clear
Set DefaultBaseFrequency=60
New Circuit.lgrules basekv=12.47 phases=3 bus1=src
Set EarthModel=Carson
Redirect library.dss
New LineGeometry.g nconds=4 nphases=3
~ cond=1 wire=ACSR_556_5 x=-4 h=28
~ cond=2 wire=ACSR_556_5 x=0 h=28
~ cond=3 wire=ACSR_556_5 x=4 h=28
~ cond=4 wire=ACSR_4/0 x=0 h=24
New LineGeometry.g x=5
New LineGeometry.h nconds=1 nphases=1 units=m
New LineGeometry.h
~ cond=1 wire=ACSR_556_5 x=0 h=28
New Line.L bus1=src.1.2.3.0 bus2=b.1.2.3.0 geometry=g length=1 units=mi
New Load.ld bus1=b phases=3 kv=12.47 kw=1000 pf=0.95
New Line.Lh bus1=src.1 bus2=bh.1 geometry=h length=1 units=mi
New Load.lh bus1=bh.1 phases=1 kv=7.2 kw=100 pf=0.95
Set voltagebases=[12.47]
CalcVoltageBases
Solve
