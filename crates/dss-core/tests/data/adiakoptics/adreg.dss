! WP-AD.2 committed A-Diakoptics fixture: synthesized radial all-3-phase feeder.
! Every branch is a 3-phase Line (any cut satisfies the D5 ZLL 3-phase-Line
! constraint); every bus carries a 3-phase load. Deterministic, self-contained.
! Reused by WP-AD.2/AD.3/AD.4. Ends at calcv (the driver solves after datapath).
clear
new circuit.admidi basekv=12.47 phases=3 bus1=sourcebus
new linecode.lc nphases=3 r1=0.15 x1=0.35 r0=0.45 x0=1.05 c1=0 c0=0 units=km
new transformer.reg phases=3 windings=2 buses=[sourcebus, regout] conns=[wye wye] kvs=[12.47 12.47] kvas=[20000 20000] xhl=0.5 %loadloss=0.01
new regcontrol.creg transformer=reg winding=2 vreg=125 band=1 ptratio=60 delay=0 eventlog=yes
new line.main1 bus1=regout bus2=m1 linecode=lc length=0.1 units=km
new load.lm1 bus1=m1 phases=3 kv=12.47 kw=120 pf=0.95 model=1
