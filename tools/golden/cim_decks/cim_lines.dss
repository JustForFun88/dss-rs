! GAPS_PLAN WPG.18 CIM export — Stage C golden deck (lines + switches + the
! conductor/spacing/geometry catalog). Vsource + Load only for the rest (Stage
! A/B); NO transformer/capacitor/reactor/regcontrol/DER so the export contains
! exactly the ported classes (a not-yet-ported class would fire a NOT_PORTED
! error and diverge from the oracle golden). Line/cable/wire data adapted from
! the vendored IEEE13_LineAndCableSpacing.dss (known-good, solvable).
Clear
Set DefaultBaseFrequency=60
New Circuit.cim_lines basekv=4.16 pu=1.00 phases=3 bus1=SourceBus angle=30

! --- overhead spacings + wires ---
New LineSpacing.sp500 nconds=4 nphases=3 units=ft x=[-4 -1 3 0] h=[28 28 28 24]
New WireData.ACSR_556_5 DIAM=0.927 GMRac=0.37320 Rdc=0.035227273 Runits=kft Radunits=in gmrunits=in
New WireData.ACSR_4_0   DIAM=0.563 GMRac=0.09768 Rdc=0.112121212 Runits=kft Radunits=in gmrunits=in

! --- cable codes + cable spacings ---
New WireData.CU_1_0 NormAmps=100 DIAM=0.368 GMRac=0.13356 Rac=0.607 Runits=mi Radunits=in gmrunits=in
New TSData.TS_1_0   NormAmps=165 DIAM=0.368 GMRac=0.13320 Rac=0.97 Runits=mi Radunits=in gmrunits=in
~ EpsR=2.3 Ins=0.220 DiaIns=0.82 DiaCable=1.06 DiaShield=0.88 TapeLayer=0.005 TapeLap=20
New CNData.CN_250   NormAmps=260 DIAM=0.567 GMRac=0.20520 Rac=0.41 Runits=mi Radunits=in gmrunits=in
~ EpsR=2.3 Ins=0.220 DiaIns=1.06 DiaCable=1.29 k=13 DiaStrand=0.0641 GmrStrand=0.02496 Rstrand=14.8722
New LineSpacing.sp515 nconds=3 nphases=3 units=ft x=[-0.5 0.0 0.5] h=[-4 -4 -4]
New LineSpacing.sp520 nconds=2 nphases=1 units=ft x=[0.0 0.25] h=[-4 -4]

! --- LineGeometry (wiredata, reduced) ---
New LineGeometry.geo3ph nconds=4 nphases=3 reduce=y
~ cond=1 wire=ACSR_556_5 x=-4 h=28 units=ft
~ cond=2 wire=ACSR_556_5 x=-1 h=28 units=ft
~ cond=3 wire=ACSR_556_5 x=3  h=28 units=ft
~ cond=4 wire=ACSR_4_0   x=0  h=24 units=ft

! --- LineCodes: symmetric-components (PerLengthSequenceImpedance) + matrix ---
New LineCode.lc_sym nphases=3 R1=0.058 X1=0.121 R0=0.1745 X0=0.4111 C1=3.4 C0=1.6 units=kft
New LineCode.mtx606 nphases=3 BaseFreq=60 units=mi
~ rmatrix=(0.7982 | 0.3192 0.7891 | 0.2849 0.3192 0.7982)
~ xmatrix=(0.4463 | 0.0328 0.4041 | -0.0143 0.0328 0.4463)
New LineCode.mtx607 nphases=1 BaseFreq=60 units=mi rmatrix=(1.3425) xmatrix=(0.5124)

! --- Lines: every ACLineSegment impedance-source path ---
! coded, symmetric-components 3-phase
New Line.l_coded_sym Bus1=SourceBus.1.2.3 Bus2=b1.1.2.3 LineCode=lc_sym Length=1.0 units=kft
! coded, matrix 3-phase
New Line.l_coded_mtx Bus1=b1.1.2.3 Bus2=b2.1.2.3 LineCode=mtx606 Length=500 units=ft
! coded, matrix 1-phase
New Line.l_coded_1ph Bus1=b2.1 Bus2=b3.1 LineCode=mtx607 Length=800 units=ft
! symmetric-components inline 3-phase (ACLineSegment.r/x/bch)
New Line.l_syminline Bus1=b1.1.2.3 Bus2=b4.1.2.3 phases=3 R1=0.05 X1=0.1 R0=0.15 X0=0.3 C1=3.0 C0=1.5 Length=0.5 units=kft
! matrix inline 2-phase (PerLengthPhaseImpedance written on the fly, "_PUZ")
New Line.l_puz Bus1=b4.1.2 Bus2=b5.1.2 phases=2 rmatrix=(0.4 | 0.1 0.4) xmatrix=(1.0 | 0.3 1.0) cmatrix=(3.0 | -0.5 3.0) Length=0.3 units=kft
! LineGeometry 3-phase
New Line.l_geom Bus1=b1.1.2.3 Bus2=b6.1.2.3 Geometry=geo3ph Length=2000 units=ft
! Spacing + Wires overhead 3-phase
New Line.l_spac Bus1=b6.1.2.3 Bus2=b7.1.2.3 Spacing=sp500 Wires=[ACSR_556_5 ACSR_556_5 ACSR_556_5 ACSR_4_0] Length=500 units=ft
! concentric-neutral cable 3-phase
New Line.l_cn phases=3 Bus1=b7.1.2.3 Bus2=b8.1.2.3 Spacing=sp515 CNCables=[CN_250 CN_250 CN_250] Length=500 units=ft
! tape-shield cable 1-phase
New Line.l_ts phases=1 Bus1=b8.1 Bus2=b9.1 Spacing=sp520 TSCables=[TS_1_0] Wires=[CU_1_0] Length=800 units=ft
! switch line with an attached Fuse (LoadBreakSwitch -> Fuse via ParseSwitchClass)
New Line.l_sw phases=3 Bus1=b1 Bus2=b10 Switch=y r1=1e-4 r0=1e-4 x1=0 x0=0 c1=0 c0=0
New Fuse.fuse1 MonitoredObj=Line.l_sw MonitoredTerm=1 SwitchedObj=Line.l_sw SwitchedTerm=1 RatedCurrent=65

! --- loads at leaf buses (a solvable radial feeder) ---
New Load.load_b3  Bus1=b3.1     phases=1 conn=Wye   Model=1 kV=2.4  kW=100 kvar=60
New Load.load_b5  Bus1=b5.1.2   phases=1 conn=Delta Model=1 kV=4.16 kW=120 kvar=80
New Load.load_b9  Bus1=b9.1     phases=1 conn=Wye   Model=1 kV=2.4  kW=80  kvar=40
New Load.load_b10 Bus1=b10.1.2.3 phases=3 conn=Wye  Model=1 kV=4.16 kW=200 kvar=120

Set Voltagebases=[4.16]
calcv
Solve
